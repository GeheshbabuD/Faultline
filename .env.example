# Copy to .env.local and fill in. .env.local is gitignored.
# Both values are optional in development and required in production.

# Postgres — Neon. Use the POOLED connection string.
# Consumed from Phase 2 onward; the design system runs without it.
DATABASE_URL=

# Required whenever DATABASE_URL is set: what the database's environment marker
# must say (docs/database-environment.md). Faultline refuses any Neon database
# whose marker does not match. FAULTLINE_DB_ENVIRONMENT is development or
# production; FAULTLINE_DB_ID is the marker's database_id (a UUID).
FAULTLINE_DB_ENVIRONMENT=
FAULTLINE_DB_ID=

# Anthropic API key. Consumed from Phase 3 onward.
# Server-side only — never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
