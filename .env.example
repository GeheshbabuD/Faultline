# Copy to .env.local and fill in what you need. .env.local is git-ignored.
# Never commit real values, and never put them in this file.
#
# Everything here is optional in local development: with no DATABASE_URL,
# Faultline uses a local PGlite database in .pglite/ and needs no credentials.

# -----------------------------------------------------------------------------
# Database (Neon serverless Postgres)
# -----------------------------------------------------------------------------
# The POOLED Neon connection string (host ends in -pooler). Contains a password.
# Required at runtime in production. Leave empty to use local PGlite.
DATABASE_URL=

# Required whenever DATABASE_URL is set. They must match the database's
# environment marker (docs/database-environment.md); Faultline refuses any
# Neon database whose marker does not match, before using it.
#   FAULTLINE_DB_ENVIRONMENT  development | production
#   FAULTLINE_DB_ID           the marker's database_id (a UUID), produced when a
#                             person marks the database; it is not a password
# Define each one once, here in .env.local, and do not also export it in your
# shell: a differing exported value is refused.
FAULTLINE_DB_ENVIRONMENT=
FAULTLINE_DB_ID=

# Do NOT set FAULTLINE_DRIZZLE_VERIFIED_DB_ID yourself. `pnpm db:studio` sets it
# for drizzle-kit only after the guard has verified the database.

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
# Anthropic API key. Validated if present, but no feature calls a model yet;
# reserved for Phase 3 (reasoning comparison). Server-side only — never prefix
# it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
